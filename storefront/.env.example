# ── Google Sheets (Database) ────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# ── Stripe (Payments) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# ── Gmail SMTP (Order & Contact Emails) ────────────────────────────────────────
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Client Store

# ── NextAuth — Google OAuth (Customer Order Tracking) ──────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Admin Panel ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password
SHIPPING_EMAIL=shipping@company.com
SHIPPING_PASSWORD=shipping@123
PACKAGING_EMAIL=packaging@company.com
PACKAGING_PASSWORD=packaging@123
PAYMENT_EMAIL=payment@company.com
PAYMENT_PASSWORD=payment@123
SUPPORT_EMAIL=support@company.com
SUPPORT_PASSWORD=support@123

# ── reCAPTCHA v3 (Contact Form Spam Protection) ────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Score threshold: 0.3 for localhost dev, 0.5+ for production
RECAPTCHA_MIN_SCORE=0.3

# ── Store URL (used in sitemap + OG tags) ──────────────────────────────────────
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# ── Google Analytics 4 (optional — loads only after user accepts analytics cookies) ─
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
